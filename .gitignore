.DS_Store
DerivedData/
.build/
xcuserdata/
*.xcuserstate

# Keep the Xcode project and asset catalog in this repository even when a
# developer's global ignore file excludes these common Xcode paths.
!MihirakiPDFUtility.xcodeproj/
!MihirakiPDFUtility.xcodeproj/**
!MihirakiPDFUtilityApp/Assets.xcassets/
!MihirakiPDFUtilityApp/Assets.xcassets/**
!migration/approved-assets/testdata/
!migration/approved-assets/testdata/**

# Keep per-user Xcode state out even though the project is explicitly included.
MihirakiPDFUtility.xcodeproj/**/xcuserdata/
MihirakiPDFUtility.xcodeproj/**/UserInterfaceState.xcuserstate

    "Double-tap twice to open a full-screen preview.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Doppeltippe zweimal, um eine Vollbildvorschau zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Haz dos toques dobles para abrir una vista previa a pantalla completa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Mag-double tap nang dalawang beses para magbukas ng full-screen na preview."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Touchez deux fois l’écran à deux reprises pour ouvrir un aperçu en plein écran."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ketuk dua kali sebanyak dua kali untuk membuka pratinjau layar penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Esegui due doppi tocchi per aprire un’anteprima a tutto schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "全画面プレビューを開くには、ダブルタップを2回します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "전체 화면 미리보기를 열려면 이중 탭을 두 번 하세요."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "पूर्ण-स्क्रिन पूर्वावलोकन खोल्न दुई पटक डबल-ट्याप गर्नुहोस्।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Efetue dois toques duplos para abrir uma pré-visualização em ecrã inteiro."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Chạm đúp hai lần để mở bản xem trước toàn màn hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "连续轻点两下两次可打开全屏预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "連續輕點兩下兩次，即可開啟全螢幕預覽。"
          }
        }
      }
    },

    "Open Version Information to run an on-device performance test." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffne „Versionsinformationen“, um einen Leistungstest auf dem Gerät auszuführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre Información de la versión para ejecutar una prueba de rendimiento en el dispositivo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buksan ang Impormasyon ng bersyon para magpatakbo ng performance test sa device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvrez « Informations sur la version » pour exécuter un test de performances sur l’appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Buka Informasi Versi untuk menjalankan uji kinerja di perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Version Information to run an on-device performance test."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "バージョン情報を開くと、デバイス上でパフォーマンステストを実行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "‘버전 정보’를 열어 기기에서 성능 테스트를 실행하세요."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "उपकरणमै कार्यसम्पादन परीक्षण चलाउन संस्करण जानकारी खोल्नुहोस्।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abra Informações da versão para executar um teste de desempenho no dispositivo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hãy mở Thông tin phiên bản để chạy kiểm tra hiệu năng trên thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "打开“版本信息”，即可在设备上运行性能测试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "開啟「版本資訊」，即可在裝置上執行效能測試。"
          }
        }
      }
    },

    "Do not imply that the author endorses you or your use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Erwecke nicht den Eindruck, dass du oder deine Nutzung vom Urheber oder von der Urheberin unterstützt werdet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No des a entender que el autor te respalda a ti o al uso que haces de la obra."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Huwag magpahiwatig na sinusuportahan ng may-akda ang iyong sarili o ang paggamit mo sa akda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ne laissez pas entendre que l’auteur vous soutient ou approuve votre utilisation de l’œuvre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jangan menyiratkan bahwa penulis mendukung Anda atau penggunaan karya oleh Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Non lasciare intendere che l’autore approvi te o il tuo utilizzo dell’opera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "作者が利用者またはその利用を支持しているかのような表示をしないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "작성자가 사용자 또는 사용자의 이용을 지지하는 것처럼 표현하지 마십시오."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "लेखकले तपाईंलाई वा तपाईंको प्रयोगलाई समर्थन गरेको संकेत नगर्नुहोस्।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não dê a entender que o autor o apoia ou aprova a sua utilização da obra."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không được ngụ ý rằng tác giả ủng hộ bạn hoặc cách bạn sử dụng tác phẩm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "不得暗示作者支持你或你的使用方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "不得暗示作者支持你或你的使用方式。"
          }
        }
      }
    },

    "Supporter icons are optional, one-time purchases. All PDF editing features remain available without a purchase.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Supporter-Icons sind optionale, einmalige Käufe. Alle PDF-Bearbeitungsfunktionen bleiben ohne Kauf verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Los iconos de apoyo son compras opcionales de pago único. Todas las funciones de edición de PDF siguen disponibles sin realizar ninguna compra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Opsyonal at isang beses lang binibili ang mga icon ng supporter. Magagamit pa rin ang lahat ng feature sa pag-edit ng PDF nang hindi bumibili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Les icônes de soutien sont des achats uniques et facultatifs. Toutes les fonctionnalités d’édition de PDF restent disponibles sans achat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ikon pendukung merupakan pembelian satu kali yang bersifat opsional. Semua fitur pengeditan PDF tetap tersedia tanpa pembelian."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "サポーターアイコンは任意で購入できる買い切り商品です。PDF編集機能は購入しなくてもすべて利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "서포터 아이콘은 선택적으로 한 번만 구입하는 항목입니다. 구입하지 않아도 모든 PDF 편집 기능을 계속 사용할 수 있습니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "समर्थक आइकनहरू वैकल्पिक, एक पटकका खरिदहरू हुन्। खरिद नगरी पनि PDF सम्पादनका सबै सुविधाहरू उपलब्ध रहन्छन्।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Os ícones de apoio são compras opcionais e únicas. Todas as funcionalidades de edição de PDF continuam disponíveis sem efetuar uma compra."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Biểu tượng ủng hộ là giao dịch mua một lần, không bắt buộc. Tất cả các tính năng chỉnh sửa PDF vẫn có thể sử dụng mà không cần mua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "支持者图标是可选的一次性购买项目。无需购买也可使用所有PDF编辑功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "支持者圖示為選購的一次性購買項目。無需購買即可繼續使用所有PDF編輯功能。"
          }
        }
      }
    },

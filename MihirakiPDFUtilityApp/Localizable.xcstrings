    "Use Restore Purchases on the Supporter Icons screen to restore previously purchased icons." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verwende „Käufe wiederherstellen“ im Bildschirm „Supporter-Icons“, um bereits gekaufte Icons wiederherzustellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usa “Restaurar compras” en la pantalla “Iconos de apoyo” para restaurar los iconos que hayas comprado anteriormente."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gamitin ang Ibalik ang mga binili sa screen na Mga Icon ng Supporter para maibalik ang mga icon na dati nang binili."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utilisez « Restaurer les achats » sur l’écran « Icônes de soutien » pour restaurer les icônes achetées précédemment."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gunakan Pulihkan Pembelian di layar Ikon Pendukung untuk memulihkan ikon yang telah dibeli sebelumnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Ripristina acquisti nella schermata Icone sostenitore per ripristinare le icone acquistate in precedenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "購入済みのアイコンは、サポーターアイコン画面の“購入を復元”から復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "이전에 구입한 아이콘을 복원하려면 ‘서포터 아이콘’ 화면에서 ‘구입 항목 복원’을 사용하세요."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पहिले खरिद गरिएका आइकनहरू पुनर्स्थापना गर्न समर्थक आइकनहरू स्क्रिनमा रहेको “खरिदहरू पुनर्स्थापना गर्नुहोस्” प्रयोग गर्नुहोस्।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utilize “Restaurar compras” no ecrã “Ícones de apoio” para restaurar os ícones comprados anteriormente."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sử dụng “Khôi phục giao dịch mua” trên màn hình “Biểu tượng ủng hộ” để khôi phục các biểu tượng đã mua trước đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在“支持者图标”屏幕上使用“恢复购买项目”，即可恢复之前购买的图标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "若要回復先前購買的圖示，請在「支持者圖示」畫面使用「回復購買項目」。"
          }
        }
      }
    },

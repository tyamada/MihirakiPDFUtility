    "Include the original source and a link to the license.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Gib die Originalquelle und einen Link zur Lizenz an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Incluye la fuente original y un enlace a la licencia."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Isama ang orihinal na pinagmulan at link sa lisensya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Indiquez la source originale et un lien vers la licence."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Sertakan sumber asli dan tautan ke lisensi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Includi la fonte originale e un link alla licenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "原典とライセンスへのリンクを記載してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "원본 출처와 라이선스 링크를 포함하세요."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "मूल स्रोत र इजाजतपत्रको लिङ्क समावेश गर्नुहोस्।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Inclua a fonte original e uma ligação para a licença."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Vui lòng ghi rõ nguồn gốc và kèm theo liên kết đến giấy phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "请注明原始来源并附上许可证链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "請註明原始來源並附上授權條款的連結。"
          }
        }
      }
    },

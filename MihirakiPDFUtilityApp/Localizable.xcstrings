          "stringUnit" : {
            "state" : "translated",
            "value" : "Pincez ou touchez deux fois pour zoomer de 1x à 5x."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubit atau ketuk ganda untuk memperbesar dari 1x hingga 5x."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pizzica o tocca due volte per ingrandire da 1x a 5x."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピンチまたはダブルタップで1〜5倍に拡大縮小します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핀치하거나 두 번 탭하여 1배에서 5배까지 확대/축소할 수 있습니다."
          }
        },
        "ne" : {

    "Images directly inside this folder will become PDF pages in the order below.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Bilder direkt in diesem Ordner werden in der folgenden Reihenfolge zu PDF-Seiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Las imágenes que están directamente en esta carpeta se convertirán en páginas PDF en el orden siguiente."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ang mga larawang nasa folder na ito mismo ay magiging mga pahina ng PDF sa pagkakasunod-sunod sa ibaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Les images directement dans ce dossier deviendront des pages PDF dans l’ordre ci-dessous."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Gambar yang berada langsung di folder ini akan menjadi halaman PDF sesuai urutan di bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Le immagini direttamente in questa cartella diventeranno pagine PDF nell’ordine seguente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "このフォルダ直下の画像を、以下の順序でPDFのページに変換します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "이 폴더 바로 안에 있는 이미지는 아래 순서대로 PDF 페이지로 변환됩니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "यस फोल्डरभित्र सिधै रहेका तस्बिरहरू तलको क्रममा PDF पृष्ठहरूमा परिणत हुनेछन्।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "As imagens diretamente nesta pasta serão convertidas em páginas PDF pela ordem abaixo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Các hình ảnh nằm trực tiếp trong thư mục này sẽ trở thành các trang PDF theo thứ tự bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "此文件夹内的图像将按以下顺序转换为PDF页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "此檔案夾內的影像將依下方順序轉換成PDF頁面。"
          }
        }
      }
    },

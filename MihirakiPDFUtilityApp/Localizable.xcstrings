    "Bronze, Silver, and Gold supporter icons are optional non-consumable purchases.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Supporter-Icons in Bronze, Silber und Gold sind optionale, nicht verbrauchbare Käufe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Los iconos de apoyo de bronce, plata y oro son compras opcionales no consumibles."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Opsyonal at hindi nauubos na mga binibili ang Bronze, Silver, at Gold na icon ng supporter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Les icônes de soutien Bronze, Argent et Or sont des achats non consommables facultatifs."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ikon pendukung Perunggu, Perak, dan Emas merupakan pembelian opsional yang tidak habis pakai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Le icone sostenitore bronzo, argento e oro sono acquisti facoltativi non consumabili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "ブロンズ、シルバー、ゴールドのサポーターアイコンは、任意で購入できる非消耗型の商品です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "브론즈, 실버 및 골드 서포터 아이콘은 선택적으로 구입할 수 있는 비소모성 항목입니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "कांस्य, रजत र स्वर्ण समर्थक आइकनहरू वैकल्पिक गैर-उपभोग्य खरिदहरू हुन्।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Os ícones de apoio de bronze, prata e ouro são compras opcionais não consumíveis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Các biểu tượng ủng hộ Đồng, Bạc và Vàng là những giao dịch mua không tiêu hao tùy chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "青铜、白银和黄金支持者图标是可选的非消耗型购买项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "青銅、白銀與黃金支持者圖示是選購的非消耗型購買項目。"
          }
        }
      }
    },

    "Your support helps keep the app updated. You can use all features without making a purchase." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deine Unterstützung hilft dabei, die App auf dem neuesten Stand zu halten. Alle Funktionen können auch ohne Kauf genutzt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu apoyo ayuda a mantener la app actualizada. Puedes usar todas las funciones sin hacer ninguna compra."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nakakatulong ang iyong suporta na panatilihing updated ang app. Magagamit mo ang lahat ng feature nang hindi bumibili."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Votre soutien contribue à maintenir l’app à jour. Vous pouvez utiliser toutes les fonctionnalités sans effectuer d’achat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dukungan Anda membantu menjaga agar app tetap diperbarui. Anda dapat menggunakan semua fitur tanpa melakukan pembelian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo supporto aiuta a mantenere l'app aggiornata. Puoi utilizzare tutte le funzionalità senza effettuare acquisti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ご支援は、アプリを継続的にアップデートするために役立ちます。購入しなくても、すべての機能を利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "후원은 앱을 지속적으로 업데이트하는 데 도움이 됩니다. 구매하지 않아도 모든 기능을 사용할 수 있습니다."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "तपाईंको सहयोगले एपलाई अद्यावधिक राख्न मद्दत गर्छ। खरिद नगरी सबै सुविधाहरू प्रयोग गर्न सक्नुहुन्छ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O seu apoio ajuda a manter a aplicação atualizada. Pode utilizar todas as funcionalidades sem efetuar uma compra."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sự ủng hộ của bạn giúp ứng dụng luôn được cập nhật. Bạn có thể sử dụng tất cả tính năng mà không cần mua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你的支持有助于持续更新App。无需购买即可使用所有功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

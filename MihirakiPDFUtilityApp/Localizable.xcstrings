    "Could not load support options. Please try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Unterstützungsoptionen konnten nicht geladen werden. Versuche es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se han podido cargar las opciones de apoyo. Inténtalo de nuevo más tarde."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hindi ma-load ang mga opsyon sa pagsuporta. Pakisubukang muli sa ibang pagkakataon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossible de charger les options de soutien. Réessayez plus tard."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opsi dukungan tidak dapat dimuat. Silakan coba lagi nanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "支援オプションを読み込めませんでした。あとでやり直してみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "후원 옵션을 불러올 수 없습니다. 나중에 다시 시도해 주세요."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "सहयोगका विकल्पहरू लोड गर्न सकिएन। कृपया पछि फेरि प्रयास गर्नुहोस्।"
          }

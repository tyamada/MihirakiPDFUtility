    "All PDF editing features are available without a purchase.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Alle PDF-Bearbeitungsfunktionen sind ohne Kauf verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Todas las funciones de edición de PDF están disponibles sin realizar ninguna compra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Magagamit ang lahat ng feature sa pag-edit ng PDF nang hindi bumibili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Toutes les fonctionnalités d’édition de PDF sont disponibles sans achat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Semua fitur pengeditan PDF tersedia tanpa pembelian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Tutte le funzioni di modifica dei PDF sono disponibili senza acquisti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "PDF編集機能は購入しなくてもすべて利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "구입하지 않아도 모든 PDF 편집 기능을 사용할 수 있습니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "खरिद नगरी पनि PDF सम्पादनका सबै सुविधाहरू उपलब्ध छन्।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Todas as funcionalidades de edição de PDF estão disponíveis sem efetuar uma compra."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Tất cả các tính năng chỉnh sửa PDF đều có thể sử dụng mà không cần mua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "无需购买即可使用所有PDF编辑功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "無需購買即可使用所有PDF編輯功能。"
          }
        }
      }
    },

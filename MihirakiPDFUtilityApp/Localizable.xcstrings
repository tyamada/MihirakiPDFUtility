    "Logs do not include file names, file contents, document metadata, or passwords. Records older than 14 days are deleted automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Protokolle enthalten keine Dateinamen, Dateiinhalte, Dokumentmetadaten oder Passwörter. Einträge, die älter als 14 Tage sind, werden automatisch gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Los registros no incluyen nombres ni contenido de archivos, metadatos de documentos ni contraseñas. Las entradas de más de 14 días se eliminan automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Les journaux ne contiennent ni noms de fichiers, ni contenu de fichiers, ni métadonnées de documents, ni mots de passe. Les entrées de plus de 14 jours sont supprimées automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "I log non includono nomi o contenuti dei file, metadati dei documenti o password. Le voci risalenti a più di 14 giorni fa vengono eliminate automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "ログにはファイル名、ファイルの内容、書類のメタデータ、パスワードは含まれません。14日を過ぎた記録は自動的に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "로그에는 파일 이름, 파일 내용, 문서 메타데이터 또는 암호가 포함되지 않습니다. 14일이 지난 기록은 자동으로 삭제됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Os registos não incluem nomes nem conteúdos de ficheiros, metadados de documentos ou palavras-passe. Os registos com mais de 14 dias são apagados automaticamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "記錄不包含檔案名稱、檔案內容、文件中繼資料或密碼。超過14天的記錄會自動刪除。"
          }
        }
      }
    },
    "Logs stay on this device, exclude personal information and PDF contents, and are deleted after 14 days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Die Protokolle verbleiben auf diesem Gerät, enthalten weder persönliche Daten noch PDF-Inhalte und werden nach 14 Tagen gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Los registros permanecen en este dispositivo, no incluyen información personal ni contenido de archivos PDF y se eliminan después de 14 días."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Nananatili sa device na ito ang mga log, hindi kasama ang personal na impormasyon at nilalaman ng PDF, at binubura pagkalipas ng 14 na araw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Les journaux restent sur cet appareil, ne contiennent aucun renseignement personnel ni contenu PDF et sont supprimés après 14 jours."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Log tetap berada di perangkat ini, tidak menyertakan informasi pribadi atau isi PDF, dan dihapus setelah 14 hari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "ログはこのデバイス内に保持され、個人情報やPDFの内容は含まれません。また、14日後に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "로그는 이 기기에만 저장되며 개인정보와 PDF 내용은 포함하지 않고 14일 후 삭제됩니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "लगहरू यस उपकरणमै रहन्छन्, तिनमा व्यक्तिगत जानकारी र PDF का सामग्री समावेश हुँदैनन्, र १४ दिनपछि मेटाइन्छन्।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Os registos permanecem neste dispositivo, não incluem informações pessoais nem conteúdo de ficheiros PDF e são eliminados após 14 dias."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Nhật ký được lưu trên thiết bị này, không chứa thông tin cá nhân hoặc nội dung PDF và sẽ bị xóa sau 14 ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "日志仅保留在此设备上，不包含个人信息或PDF内容，并会在14天后删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "記錄只保留在此裝置上，不包含個人資料或PDF內容，並會在14天後刪除。"
          }
        }
      }
    },

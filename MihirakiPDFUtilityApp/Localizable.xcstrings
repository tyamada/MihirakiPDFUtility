    "Choose a PDF to arrange, rotate, or remove pages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wähle ein PDF aus, um Seiten anzuordnen, zu drehen oder zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Selecciona un PDF para ordenar, girar o eliminar páginas."

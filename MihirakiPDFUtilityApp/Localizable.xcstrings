    "Diagnostic events will appear here as you use the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Während der Nutzung der App werden hier Diagnoseereignisse angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Los eventos de diagnóstico aparecerán aquí mientras usas la app."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Lalabas dito ang mga diagnostic event habang ginagamit mo ang app."
          }
        },
        "fr": {
          "stringUnit": {
